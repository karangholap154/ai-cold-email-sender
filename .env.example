# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration
# Choose "gemini", "anthropic", or "openai"
AI_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# Gmail SMTP Configuration
# Use a 16-character Google App Password (requires 2FA enabled on Gmail account)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# Optional: Access Gate Protection
# Set a simple password if deploying without Vercel Deployment Protection
APP_PASSWORD=
