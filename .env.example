# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration
# Choose "groq" (recommended free & ultra-fast, with auto Gemini fallback), "gemini", "anthropic", or "openai"
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# App URL & Search Console Configuration
NEXT_PUBLIC_APP_URL=https://www.meetvina.app
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-code

# Credentials Encryption Key (Encrypts user Gmail App Passwords at rest using AES-256-GCM)
# Generate a 32-byte (64 character hex) key with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Dodo Payments Configuration
DODO_PAYMENTS_API_KEY=test_your_dodo_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_key_here
DODO_PAYMENTS_PRODUCT_ID=pdt_your_pro_plan_product_id_here
DODO_PAYMENTS_ENVIRONMENT=test_mode # 'test_mode' or 'live_mode'
