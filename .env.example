# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider Configuration
# Choose "groq" (recommended free & ultra-fast, with auto Gemini fallback), "gemini", "anthropic", or "openai"
AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GEMINI_API_KEY=your-gemini-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
OPENAI_API_KEY=your-openai-api-key

# App URL Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Google OAuth Configuration (Gmail API Sending)
# Scopes needed: https://www.googleapis.com/auth/gmail.send, https://www.googleapis.com/auth/userinfo.email
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Token Encryption Key for Gmail Refresh Tokens at rest
# Generate a 32-byte (64 character hex) key with: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=your-64-character-hex-encryption-key

# Dodo Payments Configuration
DODO_PAYMENTS_API_KEY=test_your_dodo_api_key_here
DODO_PAYMENTS_WEBHOOK_KEY=whsec_your_dodo_webhook_key_here
DODO_PAYMENTS_PRODUCT_ID=pdt_your_pro_plan_product_id_here
DODO_PAYMENTS_ENVIRONMENT=test_mode # 'test_mode' or 'live_mode'
